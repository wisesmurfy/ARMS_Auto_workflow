{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)", "Bash(uv run ruff *)", "Bash(uv sync)",
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git switch *)",
      "Bash(git push -u origin step/*)",
      "PowerShell(uv run pytest *)", "PowerShell(uv run ruff *)", "PowerShell(uv sync)",
      "PowerShell(git status *)", "PowerShell(git diff *)", "PowerShell(git log *)",
      "PowerShell(git add *)", "PowerShell(git commit *)", "PowerShell(git switch *)",
      "PowerShell(git push -u origin step/*)"
    ],
    "ask": [
      "Bash(uv add *)", "Bash(uv remove *)", "Bash(rm *)",
      "PowerShell(uv add *)", "PowerShell(uv remove *)", "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Bash(git push --force*)", "Bash(git push -f *)", "Bash(git push * --force*)",
      "Bash(git push * -f)", "Bash(git push origin main*)",
      "Bash(git reset --hard*)", "Bash(git clean *)",
      "PowerShell(git push --force*)", "PowerShell(git push -f *)", "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)", "PowerShell(git push origin main*)",
      "PowerShell(git reset --hard*)", "PowerShell(git clean *)",
      "Bash(rm -rf *)", "Bash(rm -r *)", "PowerShell(Remove-Item * -Recurse*)",
      "Bash(winget *)", "Bash(choco *)", "Bash(npm install -g *)", "Bash(pip install *)",
      "PowerShell(winget *)", "PowerShell(choco *)", "PowerShell(npm install -g *)", "PowerShell(pip install *)",
      "Bash(sh)", "Bash(bash)", "PowerShell(Invoke-Expression *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
